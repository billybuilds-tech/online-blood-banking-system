{
  "name": "Online Blood Banking System",
  "short_name": "Blood Bank",
  "description": "Blood donors, recipients and blood banks in Tanzania, in one system.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
