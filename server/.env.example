# Copy this file to .env and change the values.
PORT=5000
NODE_ENV=development
HOST=127.0.0.1

# MySQL / MariaDB (XAMPP default user is root with an empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=obbs

# Use a long random string in production
JWT_SECRET=

# Blood Bank Manager (admin) account created by `npm run create-admin`
ADMIN_NAME=Blood Bank Manager
ADMIN_EMAIL=manager@obbs.local
ADMIN_PASSWORD=

# Frontend address allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Email account (optional) for "Forgot password" links and email copies of notifications.
# SMTP is required for reset emails. Reset links and message contents are never logged.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address and SMTP_PASSWORD=a
# 16-letter app password (Google Account > Security > 2-Step Verification > App passwords).
# Example SMTP_FROM: Online Blood Banking System <yourname@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
