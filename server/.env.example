# Copy this file to .env and change the values.
PORT=5000

# MySQL / MariaDB (XAMPP default user is root with an empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=obbs

# Use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Blood Bank Manager (admin) account created by `npm run create-admin`
ADMIN_NAME=Blood Bank Manager
ADMIN_EMAIL=manager@obbs.local
ADMIN_PASSWORD=Manager@2026

# Frontend address allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
