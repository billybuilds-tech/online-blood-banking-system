{
  "name": "obbs-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Online Blood Banking System",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch-path=index.js --watch-path=app.js --watch-path=config.js --watch-path=db.js --watch-path=routes --watch-path=utils --watch-path=middleware --watch-path=locales --watch-path=../shared index.js",
    "db:init": "node scripts/init-db.js",
    "db:migrate": "node scripts/migrate.js",
    "clean:test": "node scripts/clean-test-data.js",
    "create-admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:history": "node scripts/seed-history.js",
    "test:unit": "node --test tests/rules.test.js tests/security-rules.test.js",
    "test:api": "node scripts/run-tests.js",
    "test:load": "node scripts/run-tests.js --load"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "csurf": "npm:@dr.pogodin/csurf@1.18.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "10.0.16",
    "serialize-javascript": "7.1.2"
  }
}
